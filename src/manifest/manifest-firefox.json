{
  "name": "WikiTree Browser Extension",
  "description": "The official WikiTree browser extension.",
  "version": "2.11",
  "manifest_version": 2,
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "https://*.wikitree.com/*",
    "https://wikitreebee.com/*",
    "*://*.findagrave.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.perplexity.ai/*",
    "https://raw.githubusercontent.com/*",
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "contextMenus",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.wikitree.com/*", "https://wikitree.sdms.si/*", "*://*.findagrave.com/*"],
      "js": ["js/vendor.js", "js/content.js"]
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "web_accessible_resources": [
    "images/*",
    "features/wtPlus/templatesExp.json",
    "features/darkMode/darkMode.css",
    "js/*.js",
    "js/images/*",
    "fonts/*.woff2",
    "fonts/*.woff",
    "fonts/*.ttf",
    "features/text_expander/cm_helper.js",
    "features/text_expander/event_dispatcher.js"
  ],
  "icons": {
    "128": "images/we128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "in.fo@wikitree.com"
    }
  },
  "browser_action": {
    "default_icon": {
      "128": "images/we128.png"
    },
    "default_title": "WikiTree Browser Extension",
    "default_popup": "options.html"
  }
}
